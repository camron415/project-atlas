# xAI (copy key from VocalLearn .env.local — do not commit real values)
XAI_API_KEY=
XAI_API_URL=https://api.x.ai/v1

# Models — cheapest capable model per task (see server/src/models/router.ts)
XAI_CHAT_MODEL=grok-4-fast-non-reasoning
XAI_DEEP_MODEL=grok-4-fast-reasoning
XAI_SCAN_MODEL=grok-4-fast-non-reasoning
# rex = male, confident/clear (Jarvis-adjacent). Also: leo (authoritative), ara/eve (female), sal (neutral)
XAI_TTS_VOICE=rex
XAI_REALTIME_MODEL=grok-voice-think-fast-1.0
# Analyst brief synthesis (read-only reviews)
XAI_ANALYST_MODEL=grok-4-fast-non-reasoning

# Server
ATLAS_PORT=8787
ATLAS_HOST=0.0.0.0
ATLAS_LAN_IP=10.0.0.84
# Set after Tailscale setup (scripts/setup-tailscale.sh):
ATLAS_TAILSCALE_IP=
ATLAS_PUBLIC_URL=http://10.0.0.84:8787

# Streaming STT proxy (Feature A — see docs/PRODUCTION_VOICE.md)
ATLAS_STT_ENABLED=1
ATLAS_STT_SMART_TURN=0.72
ATLAS_STT_SMART_TURN_TIMEOUT=2500
ATLAS_STT_KEYTERMS=Atlas,VocalLearn,Grok
# Diarization on by default (set 0 to disable). Required for speaker profiles.
# ATLAS_STT_DIARIZE=0
# ATLAS_STT_LANGUAGE=en

# Picovoice wake word (optional — also set EXPO_PUBLIC_* for mobile embed at build time)
# PICOVOICE_ACCESS_KEY=
# EXPO_PUBLIC_WAKE_KEYWORD_PATH=hey-atlas_ios.ppn

# Set to 1 for verbose request logging ([atlas] lines) while debugging.
ATLAS_DEBUG=0

# Morning inbox brief (analyst scan → inbox/YYYY-MM-DD-morning.md)
# ATLAS_MORNING_BRIEF=1
# ATLAS_MORNING_BRIEF_PROJECTS=atlas
# ATLAS_MORNING_BRIEF_HOUR=7
# ATLAS_MORNING_BRIEF_MINUTE=0

# Phase 2 — cost ledger (Wave 0)
ATLAS_MONTHLY_BUDGET_USD=50
# ATLAS_BUDGET_WARN_PERCENT=80

# Project managers (Wave 1+)
# ATLAS_MANAGER=1
# ATLAS_MANAGER_PROJECTS=vocallearn
# ATLAS_MANAGER_HOUR=7
# ATLAS_MANAGER_MINUTE=15
# ATLAS_MANAGER_RUN_TESTS=0

# Paths
ATLAS_REGISTRY_PATH=../projects.registry.json
ATLAS_DATA_DIR=./data
