{
  "name": "@atlas/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client --host lan",
    "start:remote": "bash ../../scripts/start-mobile-remote.sh",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:device:remote": "bash ../../scripts/rebuild-ios-remote.sh",
    "ios:release": "bash ../../scripts/build-ios-release.sh",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test:audio": "npx tsx src/turn-audio-policy.test.ts",
    "test:voice": "npx tsx src/voice-endpoint.test.ts",
    "test:stt": "npx tsx src/xai-stt.test.ts",
    "test:stt-transcript": "npx tsx src/stt-transcript.test.ts"
  },
  "dependencies": {
    "atlas-audio-capture": "file:./modules/atlas-audio-capture",
    "atlas-wake-word": "file:./modules/atlas-wake-word",
    "atlas-live-activity": "file:./modules/atlas-live-activity",
    "atlas-stream-audio": "file:./modules/atlas-stream-audio",
    "atlas-realtime-playback": "file:./modules/atlas-realtime-playback",
    "atlas-widget-status": "file:./modules/atlas-widget-status",
    "expo": "~54.0.33",
    "expo-av": "~16.0.8",
    "expo-build-properties": "^56.0.17",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "^3.1.2",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
