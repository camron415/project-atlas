# Where the Atlas server is reachable from this client.
#
# - Running the app on the SAME Mac as the server (iOS Simulator / web):
#     EXPO_PUBLIC_ATLAS_SERVER_URL=http://localhost:8787
#
# - Running on a physical iPhone on the SAME WiFi as the Mac:
#     use your Mac's LAN IP (find it with: ipconfig getifaddr en0)
#     EXPO_PUBLIC_ATLAS_SERVER_URL=http://10.0.0.84:8787
#
# - Home AND away (recommended): Tailscale — run ./scripts/setup-tailscale.sh
#     EXPO_PUBLIC_ATLAS_SERVER_URL=http://100.x.x.x:8787
#
# If unset, the app defaults to http://localhost:8787.
EXPO_PUBLIC_ATLAS_SERVER_URL=http://10.0.0.84:8787
