# Where the Atlas server is reachable from this client.
#
# - Running the app on the SAME Mac as the server (iOS Simulator / web):
#     EXPO_PUBLIC_ATLAS_SERVER_URL=http://localhost:8787
#
# - Running on a physical iPhone on the SAME WiFi as the Mac:
#     use your Mac's LAN IP (find it with: ipconfig getifaddr en0)
#     EXPO_PUBLIC_ATLAS_SERVER_URL=http://10.0.0.84:8787
#
# Comma-separated URLs — probed in parallel; LAN + Tailscale covers home and remote.
# Example: http://10.0.0.84:8787,http://100.127.118.18:8787
#
# Release builds (standalone, no Metro): ./scripts/build-ios-release.sh sets these at build time.
EXPO_PUBLIC_ATLAS_SERVER_URL=http://10.0.0.84:8787

# Stream mic audio to Mac → xAI STT (Smart Turn). Requires native rebuild.
EXPO_PUBLIC_XAI_STT=1

# Foreground wake word (Picovoice). See docs/WAKE_WORD.md.
# EXPO_PUBLIC_WAKE_WORD=1
# EXPO_PUBLIC_PICOVOICE_ACCESS_KEY=
# EXPO_PUBLIC_WAKE_KEYWORD_PATH=hey-atlas_ios.ppn
